// Prisma schema for Clavicular.AI
// Using PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// USER AUTHENTICATION & ACCOUNTS
// =====================================================

// Main user account - syncs with Supabase Auth
model User {
  id                String    @id // Uses Supabase Auth UUID
  email             String    @unique
  emailVerified     DateTime?
  
  // Profile info
  name              String?
  displayName       String?   // Shown on leaderboard
  avatarUrl         String?
  age               Int?
  
  // Access tier for gating features
  accessTier        String    @default("REGISTERED") // FREE, REGISTERED, PREMIUM
  
  // PayPal subscription fields
  subscriptionId       String?   @unique
  subscriptionPlan     String?   // monthly | yearly | trial_referral
  subscriptionStatus   String?   // TRIAL | ACTIVE | CANCELLED | SUSPENDED | EXPIRED
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  
  // User's data
  analysisSessions  AnalysisSession[]
  leaderboardEntry  LeaderboardEntry? // One entry per user
  beautyChats       BeautyChat[]
  transformations   Transformation[]
  savedAdvice       SavedAdvice[]
  
  // Referral system
  referralCode      ReferralCode?     // User's unique referral code
  referredBy        Referral?         @relation("ReferredUser") // Who referred this user
  referrals         Referral[]        @relation("ReferrerUser") // Users this user referred
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
}

// Persisted protocol / physique / fashion guidance for premium users
model SavedAdvice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // softmax | hardmax | physique | fashion
  type      String
  payload   String   // JSON blob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

// =====================================================
// FACIAL ANALYSIS DATA
// =====================================================

// Facial features and their ideal values
model Feature {
  id                String   @id
  name              String
  category          String   // HARM, MISC, ANGU, DIMO
  importance        String   // highest, high, medium, low
  idealValue        String
  measurementMethod String?
  weight            Float    @default(1.0)
  issues            Issue[]  @relation("FeatureIssues")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Issues that can be detected from analysis
model Issue {
  id           String        @id
  displayName  String
  description  String?
  severity     String?       // mild, moderate, severe
  features     Feature[]     @relation("FeatureIssues")
  improvements Improvement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Improvement methods linked to issues
model Improvement {
  id            String    @id @default(cuid())
  issueId       String
  issue         Issue     @relation(fields: [issueId], references: [id])
  type          String    // SOFT, SEMI, HARD
  name          String
  description   String
  timeline      String?
  effectiveness String?
  costMin       Float?
  costMax       Float?
  risks         String?   // JSON array stored as string
  products      Product[] @relation("ImprovementProducts")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Products that can help with improvements
model Product {
  id                  String        @id @default(cuid())
  name                String
  category            String        // skincare, haircare, device, supplement, injectable, surgical
  subcategory         String?
  priceMin            Float?
  priceMax            Float?
  purchaseUrls        String?       // JSON array stored as string
  imageUrl            String?       // Product image URL
  brand               String?       // Product brand name
  activeIngredients   String?       // JSON array stored as string
  effectivenessRating Float?
  riskLevel           String?       // low, medium, high
  requiresPrescription Boolean      @default(false)
  usageInstructions   String?
  timelineToResults   String?
  sideEffects         String?       // JSON array stored as string
  improvements        Improvement[] @relation("ImprovementProducts")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// Store analysis sessions - linked to user (optional for anonymous)
model AnalysisSession {
  id              String   @id @default(cuid())
  
  // Link to user (optional - allows anonymous analysis)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  overallScore    Float
  harmScore       Float
  miscScore       Float
  anguScore       Float
  dimoScore       Float
  measurements    String   // JSON stored as string
  features        String   // JSON stored as string
  recommendations String?  // JSON stored as string
  profileMode     String   // front, side
  
  // AI before/after transformation cache
  beforeImageUrl  String?
  afterImageUrl   String?
  afterPrompt     String?
  afterGeneratedAt DateTime?
  
  transformations Transformation[]
  
  createdAt       DateTime @default(now())
}

// History of AI face transformations (subscription value)
model Transformation {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  analysisSessionId String?
  analysisSession   AnalysisSession? @relation(fields: [analysisSessionId], references: [id], onDelete: SetNull)
  beforeImageUrl    String
  afterImageUrl     String
  afterPrompt       String?
  source            String   @default("protocol") // protocol | beauty_bot | rescan
  createdAt         DateTime @default(now())
}

// Beauty chatbot conversations for subscribed users
model BeautyChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  String   // JSON array of { role, content, imageUrl? }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Public leaderboard entries - one per user
model LeaderboardEntry {
  id              String   @id @default(cuid())
  
  // Link to user account (required for leaderboard)
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  name            String
  age             Int
  imageUrl        String   // Supabase storage URL
  overallScore    Float
  harmScore       Float
  miscScore       Float
  anguScore       Float
  dimoScore       Float
  rarity          String
  features        String   // JSON stored as string - top features
  hidden          Boolean  @default(false) // User can hide from public leaderboard
  consentedAt     DateTime // When user consented to public display
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Shareable analysis results with 24hr expiration
model ShareLink {
  id              String   @id @default(cuid())
  
  // Image stored in Supabase storage
  imageUrl        String
  
  // Analysis results
  overallScore    Float
  harmScore       Float
  miscScore       Float
  anguScore       Float
  dimoScore       Float
  rarity          String
  features        String   // JSON stored as string - top features
  
  // Expiration - 24 hours from creation
  expiresAt       DateTime
  
  // Timestamps
  createdAt       DateTime @default(now())
}

// =====================================================
// REFERRAL SYSTEM
// =====================================================

// Unique referral code for each user
model ReferralCode {
  id              String   @id @default(cuid())
  
  // The unique code (e.g., "JOHN123" or auto-generated)
  code            String   @unique
  
  // Owner of this referral code
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Referrals made with this code
  referrals       Referral[]
  
  // Stats
  usageCount      Int      @default(0)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Track referrals between users
model Referral {
  id              String   @id @default(cuid())
  
  // The referral code used
  referralCodeId  String
  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  
  // The user who made the referral (code owner)
  referrerId      String
  referrer        User     @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  
  // The user who was referred (signed up with the code)
  referredUserId  String   @unique
  referredUser    User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  
  // Reward status
  rewardGranted   Boolean  @default(false)
  rewardGrantedAt DateTime?
  
  // Timestamps
  createdAt       DateTime @default(now())
}